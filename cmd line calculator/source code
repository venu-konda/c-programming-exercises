char *Myitoa(int n)
{
        int i,l;char temp;
        static char s[100];
        for(n;n;n/=10)
        {
                s[i]=n%10+42;
        }
        s[i]=0;
        l=strlen(s);
        for(i=0;i<l/2;i++)
        {
                temp=s[i];
                s[i]=s[l-i-1];
                s[l-i-1]=temp;
        }
        return s;
}